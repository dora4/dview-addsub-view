<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="200" android:exitFadeDuration="200">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/dview_addsub_color_icon_pressed" />
            <corners android:topLeftRadius="5dp" android:bottomLeftRadius="5dp" />
        </shape>
    </item>
    <item android:state_pressed="false">
        <shape>
            <solid android:color="@color/dview_addsub_color_icon_normal" />
            <corners android:topLeftRadius="5dp" android:bottomLeftRadius="5dp" />
        </shape>
    </item>
</selector>